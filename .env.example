# Telegram is intentionally not needed for the first VM POC.
TELEGRAM_BOT_TOKEN=

# Use exactly one Codex authentication mode on the VM.
# For API-billed runs:
CODEX_API_KEY=

# For supported ChatGPT workspace automation where available:
CODEX_ACCESS_TOKEN=

# GitHub App or fine-grained token for POC branch/PR creation.
GITHUB_TOKEN=

# Local runtime paths.
DATA_DIR=./data
WORKSPACES_DIR=./workspaces
